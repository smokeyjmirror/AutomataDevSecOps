POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-a-unique-random-value
POSTGRES_DB=automata
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-unique-random-value
SESSION_COOKIE_SECURE=false
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-unique-local-only-password
OIDC_ISSUER=http://localhost:8080/realms/automata
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/automata/.well-known/openid-configuration
OIDC_CLIENT_ID=automata-app
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/auth/callback
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8080/realms/automata/protocol/openid-connect/auth
OIDC_TOKEN_ENDPOINT=http://keycloak:8080/realms/automata/protocol/openid-connect/token
OIDC_JWKS_URI=http://keycloak:8080/realms/automata/protocol/openid-connect/certs
OIDC_LOGOUT_ENDPOINT=
OIDC_ROLES_CLAIM=roles
OIDC_CUSTOMER_ROLE=customer
OIDC_STAFF_ROLE=staff
OIDC_EMAIL_CLAIM=email
OIDC_EMAIL_VERIFIED_CLAIM=email_verified
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
FRONTEND_ORIGINS=http://localhost:8000,http://localhost:8001
DEMO_CUSTOMER_USERNAME=
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=